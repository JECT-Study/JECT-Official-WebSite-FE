    "/email/send/auth": {
      "post": {
        "tags": ["Email"],
        "summary": "인증 번호 발송",
        "description": "지정된 이메일로 인증 번호를 발송합니다.",
        "operationId": "sendAuthEmail",
        "parameters": [
          {
            "name": "sendGroupCode",
            "in": "query",
            "description": "이메일 템플릿",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["AUTH_CODE", "PIN_RESET"]
            },
            "examples": {
              "AUTH_CODE": {
                "summary": "이메일 인증 코드 안내",
                "description": "AUTH_CODE",
                "value": "AUTH_CODE"
              },
              "PIN_RESET": {
                "summary": "PIN 재설정 인증 코드 안내",
                "description": "PIN_RESET",
                "value": "PIN_RESET"
              }
            }
          },
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "리프레시 토큰을 이용한 액세스 토큰 재발급",
        "description": "리프레시 토큰이 유효한 경우 새로운 액세스 토큰을 발급합니다.",
        "operationId": "refreshToken",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "/auth/code": {
      "post": {
        "tags": ["Auth"],
        "summary": "인증번호 검증",
        "description": "인증번호 검증만 수행하고 임시 토큰을 발급합니다.",
        "operationId": "verifyAuthCode",
        "parameters": [
          {
            "name": "template",
            "in": "query",
            "description": "이메일 템플릿",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["AUTH_CODE", "PIN_RESET"]
            },
            "examples": {
              "AUTH_CODE": {
                "summary": "이메일 인증 코드 안내",
                "description": "AUTH_CODE",
                "value": "AUTH_CODE"
              },
              "PIN_RESET": {
                "summary": "PIN 재설정 인증 코드 안내",
                "description": "PIN_RESET",
                "value": "PIN_RESET"
              }
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyAuthCodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "default response",
            "headers": {
              "verificationToken": {
                "description": "검증 토큰",
                "style": "simple"
              },
              "accessToken": {
                "description": "액세스 토큰",
                "style": "simple"
              },
              "refreshToken": {
                "description": "프레시레시 토큰",
                "style": "simple"
              }
            },
            "content": {
              "*/*": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
