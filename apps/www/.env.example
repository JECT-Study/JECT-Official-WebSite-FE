# 백엔드 API 주소. 개발 서버는 https://dev.api.ject.kr
# next.config.ts의 /api/:path* 재작성 대상이다.
NEXT_PUBLIC_API_URL=

# 사이트 절대 주소. metadataBase에 사용한다.
# 비워두면 VERCEL_URL, http://localhost:3000 순으로 대체한다.
NEXT_PUBLIC_SITE_URL=

# E2E 대상 주소. 지정하면 Playwright가 앱을 직접 실행하지 않는다.
E2E_BASE_URL=

# legacy로 지정하면 아직 이전하지 않은 경로까지 스모크 대상에 포함한다.
E2E_TARGET=
