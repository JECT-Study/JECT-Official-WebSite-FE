# 백엔드 API 주소. 개발 서버는 https://dev.api.ject.kr
# next.config.ts의 /api/:path* 재작성 대상이다.
NEXT_PUBLIC_API_URL=

# 사이트 절대 주소. metadataBase에 사용한다.
# 비워두면 VERCEL_URL, http://localhost:3000 순으로 대체한다.
NEXT_PUBLIC_SITE_URL=

# Sentry 프로젝트 DSN. 비워두면 Sentry로 이벤트를 보내지 않는다.
NEXT_PUBLIC_SENTRY_DSN=

# 소스맵 업로드에 사용한다. 빌드 환경에만 지정한다.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Sentry 이슈 알림을 Discord로 전달하는 웹훅에 사용한다. 운영 서버 실행 환경에 지정한다.
SENTRY_WEBHOOK_SECRET=
DISCORD_WEBHOOK_URL=

# Amplitude 프로젝트 API 키. 비워두면 Amplitude로 이벤트를 보내지 않는다.
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# true로 지정하면 운영 빌드가 아니어도 Amplitude로 이벤트를 보낸다. QA에서 확인할 때 사용한다.
NEXT_PUBLIC_ANALYTICS_DEBUG=

# E2E 대상 주소. 지정하면 Playwright가 앱을 직접 실행하지 않는다.
E2E_BASE_URL=
